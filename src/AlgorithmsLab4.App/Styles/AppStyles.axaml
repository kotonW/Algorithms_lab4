<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.stat">
    <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="11,8" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource AppChipBrush}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>

  <Style Selector="Border.legend-item">
    <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="7,4" />
  </Style>

  <Style Selector="TextBlock.app-title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.1" />
    <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    <Setter Property="Margin" Value="0,2,0,6" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.info">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="20" />
  </Style>

  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="TextBlock.big-value">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="TextBlock.good">
    <Setter Property="Foreground" Value="{DynamicResource AppGoodBrush}" />
  </Style>

  <Style Selector="TextBlock.bad">
    <Setter Property="Foreground" Value="{DynamicResource AppBadBrush}" />
  </Style>

  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource AppWarnBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,7" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource AppBadBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{DynamicResource AppChipBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="Button.small">
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
  </Style>

  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.log-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="Margin" Value="0,0,0,1" />
  </Style>

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="FontSize" Value="12" />
  </Style>

</Styles>
